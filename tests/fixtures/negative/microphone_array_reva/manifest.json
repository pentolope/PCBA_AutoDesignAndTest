  "waivers": [],
  "geometry_profile": {
    "version": "geom-1",
    "tolerances": {
      "polygon_chord_error_mm": {
        "value": 0.001,
        "units": "mm",
        "why": "outward chord error when polygonising arcs; conservative direction only.",
        "provenance": "maximum chord error when a curve is approximated by a polygon, applied outward (pcbnew ERROR_OUTSIDE) so an approximation can never over-state a clearance. Removed constants: native_gerber_match_mm and coincidence_mm were declared but never applied; coordinate_match_mm and contact_mm carry those roles."
      },
      "rotation_match_deg": {
        "value": 0.1,
        "units": "deg",
        "why": "CPL rotation is written to 4 dp; this bounds formatting round-trip."
      },
      "coordinate_match_mm": {
        "value": 0.002,
        "units": "mm",
        "why": "Gerber coordinates are written at 1e-6 mm; this bounds format round-trip when matching an exported object to a native one."
      },
      "dimension_match_mm": {
        "value": 0.002,
        "units": "mm",
        "why": "aperture and drill diameters are written to 6 dp."
      },
      "clearance_match_mm": {
        "value": 0.01,
        "units": "mm",
        "why": "native shapes are polygonised outward at 1 um; Gerber apertures are re-polygonised independently, so identical geometry can differ by a few chord errors."
      },
      "layer_symmetric_difference_mm2": {
        "value": 0.05,
        "units": "mm2",
        "why": "two independent polygonisations of the same layer differ only by chord error along shared boundaries."
      },
      "contact_mm": {
        "value": 1e-06,
        "units": "mm",
        "why": "Two independent polygonisations of the same tangency can leave a sub-nanometre gap. Separation at or below this is treated as contact, i.e. as loss of the solder-mask ink dam."
      },
      "waiver_location_mm": {
        "value": 0.001,
        "units": "mm",
        "provenance": "waiver matching: a finding must be at the coordinate the reviewer approved. One micrometre is below KiCad's own report rounding, so a genuinely relocated finding never matches an old waiver."
      }
    }
  },
