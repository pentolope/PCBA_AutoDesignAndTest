          Me
        </span></a></li></ul></div></div></div></div><script>window.__NUXT__=(function(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z,A,B,C,D,E,F,G,H){H.pageName=w;H.languageCode=m;H.pageStation="https:\u002F\u002Fjlcpcb.com\u002F";H.pageUrl="pcb-thickness";H.pageType="resources";H.seoTitle="Choose the Thickness of PCB";H.seoDescription="The thickness of PCBs impacts the performance, stability, and reliability of the final electronic products.";H.seoKeyword="PCB Thickness, JLCPCB";H.seoH1=c;H.seoH2=c;H.auditPassFlag=a;return {layout:"default",data:[{components:[{id:"banner组件-12",type:v,typeLabel:"banner组件",componentName:"plugin-lcBanner",wmComponent:"lcBanner",icon:"el-icon-files",wState:{targetId:c,backgroundColor:"rgba(5, 254, 229, 1)",backgroundImgPc:"https:\u002F\u002Fstatic.jlcpcb.com\u002Fassets\u002Fdecorate\u002Ff8e36150cd8d4908b9521d3482bdcfda.jpg",backgroundImgMobile:c,title:w,titleColor:x,description:"The thickness of PCBs impacts the performance, stability, and reliability of the final electronic products. Now, JLCPCB offers a variety of PCB thickness options to help you make the best and affordable choice. Thickness from 0.8mm to 1.6mm starts at only $2.",textColor:x,showType:n,couponAmount:o,couponTitle:"PCB Coupon",couponDesc:"Valid for 30 days",couponBtnText:"Get It Now",couponList:[{couponsRecordId:2685,titleC:"专题页-PCB 6美金优惠券",titleE:"$6 PCB Coupon",couponsUsedType:k,couponsType:f,couponsCode:c,denomination:o,chargeType:y,orderType:k,usedCount:f,minAmount:.1,validDate:"2025-02-19T16:00:00.000Z",expiryDate:"2035-02-19T16:00:00.000Z",couponsStatus:f,validDateLimitStr:"自领取后30天有效",dispenseCount:n,maxCount:10000,couponsRecordNo:"ee98bdc9af6743129524e93b3170aa9d",promotionTitle:d,canUseDays:30,maxDispenseCount:f,preventRepeat:b,areasSupported:c,couponsUniqueCode:d,noDeductionMoney:f,noDeductionCarriageMoney:.5,allDispense:a,preventLevel:f,areasProhibit:c}],jumpUrl:c,btnBgColor:p,btnText:"按钮名称",btnTextColor:z,isReceived:a,textAlign:"left",couponAmountColor:A,couponTitleColor:A,couponDescColor:"rgba(208, 189, 41,1)",couponBtnTextColor:"rgba(255, 255, 255,1)"},dragInfo:{x:e,y:e,w:g,h:440,rotateZ:e},rename:c,lock:a,visible:b,initHook:d,layerPanelVisible:b,replicable:b,isCopied:a,removable:b,couldAddToActive:b,componentState:d,_sort:f,_isBackup:b},{id:"图文组件-13",type:j,typeLabel:q,componentName:r,wmComponent:s,icon:t,wState:{targetId:c,backgroundColor:"rgba(255, 255, 255, 1)",title:"Characteristics of PCB Thickness",titleColor:h,textColor:h,imgUrl:"https:\u002F\u002Fstatic.jlcpcb.com\u002Fassets\u002Fdecorate\u002F6bde7a14200e443297ed804822b2bd60.jpg",imgJumpUrl:l,imageAlt:c,videoUrl:c,videoHeight:u,isYoutube:a,paragraphText:B,paragraphList:[{title:"Ultra-thin PCB (below 0.6 mm):",text:"Ultra-thin PCBs are lightweight, soft, and easy to bend, making them suitable for products that require a high level of space efficiency, such as smartphones, wearable devices and drones."},{title:"Mid-Range Thin PCBs (0.6-1.6 mm):",text:"The mid-range PCB has a good balance between thickness and load-bearing capacity, making it suitable for a wide range of electronic products, including computer motherboards and home appliance control boards."},{title:"Thicker PCBs (above 1.6 mm):",text:"Thick boards have a high load-bearing capacity and stiffness, making them suitable for harsh environments and electronic products that require the carrying of high-power and heavy components."}],showType:k,isReverse:a,allCenter:a},dragInfo:{x:e,y:C,w:g,h:D,rotateZ:e},rename:c,lock:a,visible:b,initHook:d,layerPanelVisible:b,replicable:b,isCopied:a,removable:b,couldAddToActive:b,componentState:d,_sort:k,_isBackup:b},{id:"图文组件-14",type:j,typeLabel:q,componentName:r,wmComponent:s,icon:t,wState:{targetId:c,backgroundColor:c,title:"Key factors affecting PCB Thickness",titleColor:h,textColor:h,imgUrl:"https:\u002F\u002Fstatic.jlcpcb.com\u002Fassets\u002Fdecorate\u002Fe651ee6fd1c54c229724275beda3aaf9.png",imgJumpUrl:l,imageAlt:c,videoUrl:c,videoHeight:u,isYoutube:a,paragraphText:"Circuit board thickness is influenced by PCB layer count, signal type, material selection, operating environment, copper thickness, and special requirements. More copper layers increase thickness. High-power signals demand thicker copper layers and wider traces; low-power environments can use thinner boards. Material choice and operating conditions impact thickness. Copper thickness, such as 2 or 3 ounces, significantly affects overall thickness. Special applications, like high-density boards, may require customized thickness for unique environments.",paragraphList:[],showType:f,isReverse:b,allCenter:a},dragInfo:{x:e,y:1160,w:g,h:C,rotateZ:e},rename:c,lock:a,visible:b,initHook:d,layerPanelVisible:b,replicable:b,isCopied:a,removable:b,couldAddToActive:b,componentState:d,_sort:y,_isBackup:b},{id:"图文组件-15",type:j,typeLabel:q,componentName:r,wmComponent:s,icon:t,wState:{targetId:c,backgroundColor:c,title:"How to Choose the Appropriate PCB Thickness",titleColor:h,textColor:h,imgUrl:"https:\u002F\u002Fstatic.jlcpcb.com\u002Fassets\u002Fdecorate\u002Fbcf8da5ad0b14839ad6a2d11b68fe6ef.png",imgJumpUrl:l,imageAlt:c,videoUrl:c,videoHeight:u,isYoutube:a,paragraphText:B,paragraphList:[{title:"Application Focus:",text:"Before deciding on PCB thickness, understanding application needs, scenarios, and component loads is crucial.This ensures the chosen thickness aligns with product requirements."},{title:"Safety Concerns:",text:"If the circuit board needs to withstand high voltage or current, it is important to select a thicker circuit board to ensure its safe operation."},{title:"Mechanical Strength:",text:"If the circuit board needs to withstand high mechanical influence, it is advisable to choose a thicker PCB to ensure its mechanical strength"}],showType:k,isReverse:a,allCenter:a},dragInfo:{x:e,y:1710,w:g,h:D,rotateZ:e},rename:c,lock:a,visible:b,initHook:d,layerPanelVisible:b,replicable:b,isCopied:a,removable:b,couldAddToActive:b,componentState:d,_sort:n,_isBackup:b},{id:"优点展示组件-16",type:E,typeLabel:"优点展示组件",componentName:"plugin-lcBenefits",wmComponent:"lcBenefits",icon:"el-icon-circle-check",wState:{targetId:c,backgroundColor:c,title:"Why Choose JLCPCB",titleColor:i,articleList:[{iconUrl:"https:\u002F\u002Fstatic.jlcpcb.com\u002Fassets\u002Fdecorate\u002F224738ed240e40a1b1983251c17067c5.png",title:"Easy Ordering Process",titleColor:i,content:"Upload your Gerber file and then get an instant quote! Easy as online shopping.",contentColor:i},{iconUrl:"https:\u002F\u002Fstatic.jlcpcb.com\u002Fassets\u002Fdecorate\u002F4f877738980a4d3a9842683124cd1655.png",title:"Affordable Manufacturing",titleColor:i,content:"Get 1-8 layer PCBs for just $2! Efficient large-scale production offers unbeatable prices.",contentColor:i},{iconUrl:"https:\u002F\u002Fstatic.jlcpcb.com\u002Fassets\u002Fdecorate\u002F98fc29f7eb4f4de283243840f1b56f88.png",title:"Reliable Services",titleColor:i,content:"In-house production with strict quality control. Fast PCB production in just 24 hours!",contentColor:i}]},dragInfo:{w:g,h:350,x:e,y:2310,rotateZ:e},rename:c,lock:a,visible:b,initHook:d,layerPanelVisible:b,replicable:b,isCopied:a,removable:b,couldAddToActive:b,componentState:d,_sort:5,_isBackup:b},{id:"横幅组件-17",type:F,typeLabel:"横幅组件",componentName:"plugin-lcStreamer",wmComponent:"lcStreamer",icon:"el-icon-collection-tag",wState:{backgroundColor:c,title:"Choose Your PCB Thickness Now",titleColor:p,isColumn:a,backgroundImg:"https:\u002F\u002Fstatic.jlcpcb.com\u002Fassets\u002Fdecorate\u002Fc3f17a8fafdd4b91b5f36c09066ecce7.png",jumpUrl:l,btnBgColor:p,btnText:"Get Instant Quote",btnTextColor:z},dragInfo:{x:e,y:3140,w:g,h:160,rotateZ:e},rename:c,lock:a,visible:b,initHook:d,layerPanelVisible:b,replicable:b,isCopied:a,removable:b,couldAddToActive:b,componentState:d,_sort:o,_isBackup:b},{id:"FAQ组件-18",type:G,typeLabel:"FAQ组件",componentName:"plugin-lcFaq",wmComponent:"lcFaq",icon:"el-icon-chat-dot-square",wState:{title:"Frequently Asked Questions\n",targetId:c,titleColor:h,questionsList:[{title:"What PCB thicknesses does JLCPCB offer?",titleColor:h,isExtend:a,content:"We offer the following thickness options: 0.4mm, 0.6mm, 0.8mm, 1.0mm, 1.2mm, 1.6mm, 2.0mm. Note that 2-layer PCBs with 0.6mm thickness do not support HASL (with lead) surface finish."},{title:"What is the thickness tolerance of your PCBs?",isExtend:a,content:"The thickness tolerance of our PCBs is +\u002F-10% of the finished board thickness."},{title:"Anything I should know when selecting 0.4mm thickness boards?",isExtend:a,content:"For 0.4mm thickness boards, only ENIG finish is accepted. These boards cannot be made with a panel and are not available for 1-layer PCBs."},{title:"Anything I should know when selecting 0.6mm thickness boards?",isExtend:a,content:"Boards with 0.6mm thickness have a maximum size of 100mm x 100mm. This thickness is not available for 1-layer, 4-layer, or 6-layer PCBs."},{title:"Anything I should know when selecting 0.8-1.0mm thickness boards?",isExtend:a,content:"For boards with 0.8mm to 1.0mm thickness, the maximum size is 300mm x 300mm."}],isUpdateNum:19},dragInfo:{w:g,h:450,x:e,y:2660,rotateZ:e},rename:c,lock:a,visible:b,initHook:d,layerPanelVisible:b,replicable:b,isCopied:a,removable:b,couldAddToActive:b,componentState:d,_sort:7,_isBackup:b}],pageInfo:{pageSettingForm:H,config:"{\"referenceLine\":{\"row\":[579],\"col\":[]},\"canvasSize\":{\"width\":1240,\"height\":3300}}",items:[{type:"background",content:c,config:"{\"id\":\"背景-19\",\"type\":\"background\",\"typeLabel\":\"背景\",\"componentName\":\"background-widget\",\"wmComponent\":\"\",\"icon\":\"icon-background\",\"wState\":{\"isSolid\":true,\"src\":\"\",\"style\":{\"backgroundColor\":\"#fff\"}},\"dragInfo\":{\"w\":1240,\"h\":3300,\"x\":0,\"y\":0,\"rotateZ\":0},\"rename\":\"\",\"lock\":true,\"visible\":true,\"initHook\":null,\"layerPanelVisible\":true,\"replicable\":false,\"isCopied\":false,\"removable\":true,\"couldAddToActive\":false,\"componentState\":null,\"backgroundCo